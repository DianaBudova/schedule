<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Schedule</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 2rem; }
    input, select { display: block; margin: 0.5rem 0; padding: 0.5rem; width: 300px; }
    button { padding: 0.5rem 1rem; }
    .message { color: red; }
    table { border-collapse: collapse; margin-top: 1rem; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 0.5rem; }
    th { background: #f2f2f2; }
    form.inline { display: inline; }
  </style>
</head>
<body>
  <h1>Edit Schedule</h1>
  <% if(foundExistingCourse) { %>
    <p class="message"><%= foundExistingCourse %></p>
  <% } %>

  <form action="/create" method="post">
    <input type="text" name="courseName" placeholder="Course Name" required />
    <input type="text" name="type" placeholder="Type" />
    <input type="text" name="cabinet" placeholder="Cabinet" />
    <input type="text" name="professor" placeholder="Professor" />
    <input type="text" name="weekday" placeholder="Weekday" />
    <input type="text" name="week" placeholder="Week" />
    <input type="text" name="time" placeholder="Time" />
    <input type="text" name="classroom" placeholder="Classroom" />
    <input type="text" name="students" placeholder="Students" />
    <input type="text" name="currentMarks" placeholder="Current Marks" />
    <input type="text" name="works" placeholder="Works" />
    <input type="text" name="other" placeholder="Other" />
    <button type="submit">Add Course</button>
  </form>

  <h2>Current Courses</h2>
  <table>
    <thead>
      <tr>
        <th>Course</th>
        <th>Type</th>
        <th>Week</th>
        <th>Day</th>
        <th>Time</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if(courses.length === 0) { %>
        <tr><td colspan="6">No courses yet</td></tr>
      <% } %>
      <% courses.forEach(c => { %>
        <tr>
          <td><%= c.name %></td>
          <td><%= c.type %></td>
          <td><%= c.week %></td>
          <td><%= c.weekday %></td>
          <td><%= c.time %></td>
          <td>
            <form class="inline" action="/delete" method="post">
              <input type="hidden" name="idDelete" value="<%= c.id %>" />
              <button type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <p><a href="/">Back to Schedule</a></p>
</body>
</html>
